{
  "name": "together-working-repo",
  "private": true,
  "description": "투게더워킹 저장소 — 앱(apps/desktop) · 웹 관리자(apps/admin) · 메인 홈페이지(apps/web) · 캐릭터 코어(packages/) · Firebase(firebase/)",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm --prefix apps/desktop install",
    "start": "npm --prefix apps/desktop start",
    "start:dev": "npm --prefix apps/desktop run start:dev",
    "check": "node checks/run.js",
    "admin:dev": "npm --prefix apps/admin run dev",
    "admin:test": "npm --prefix apps/admin test",
    "admin:build": "npm --prefix apps/admin run build",
    "web:build": "npm -w @tw/web run build",
    "design:build": "node scripts/build-design-tokens.js",
    "version:bump": "node scripts/bump-version.js",
    "pack": "npm --prefix apps/desktop run pack",
    "dist": "npm --prefix apps/desktop run dist"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "license": "UNLICENSED"
}
