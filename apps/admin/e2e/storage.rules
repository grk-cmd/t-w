rules_version = '2';
// e2e 에뮬레이터 전용 — 저장소에 실제 Storage 규칙 파일이 없어(콘솔에서 관리) 로그인한 사용자에게 열어 둔다.
// 이 파일은 e2e/firebase.json 만 쓴다. 저장소 루트 firebase.json 에는 storage 설정을 넣지 않는다(배포 때 콘솔 규칙을 덮어쓴다).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
