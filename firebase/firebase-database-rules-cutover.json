{
  "rules": {
    ".read": false,
    ".write": false,
    "config": {
      "minAppVer": {
        ".read": true,
        ".write": false,
        ".validate": "newData.isString() && newData.val().length <= 20"
      },
      "minRoomVer": {
        ".read": true,
        ".write": false,
        ".validate": "newData.isString() && newData.val().length <= 20"
      },
      "maintenance": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['on']) && newData.child('on').isBoolean()",
        "on": {},
        "endsAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "admins": {
      ".read": false,
      "$uid": {
        ".write": false
      }
    }
  }
}
