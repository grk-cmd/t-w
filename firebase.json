{
  "database": {
    "rules": "firebase-database-rules.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": [{
    "target": "main",
    "public": "hosting",
    "predeploy": ["npm --prefix web-admin ci", "npm --prefix web-admin run build"],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "help/**"],
    "cleanUrls": true,
    "redirects": [
      { "source": "/privacy", "destination": "https://help.together-working.com/privacy", "type": 301 },
      { "source": "/privacy.html", "destination": "https://help.together-working.com/privacy", "type": 301 },
      { "source": "/link", "destination": "https://help.together-working.com/link", "type": 301 },
      { "source": "/link.html", "destination": "https://help.together-working.com/link", "type": 301 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/admin/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://apis.google.com https://*.firebasedatabase.app; style-src 'self'; img-src 'self' data: https:; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://*.firebasedatabase.app wss://*.firebasedatabase.app https://api.github.com https://rooms.togetherworking.duckdns.org https://rooms-dev.togetherworking.duckdns.org https://api.togetherworking.duckdns.org https://api.together-working.com https://realtime.together-working.com; frame-src https://*.firebaseapp.com https://accounts.google.com; object-src 'none'; base-uri 'none'; form-action 'none'"
          },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      }
    ]
  }, {
    "target": "help",
    "public": "hosting/help",
    "ignore": ["**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }]
}