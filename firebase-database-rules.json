{
  "rules": {
    ".read": false,
    ".write": false,
    "srKey": {
      ".read": false,
      ".write": false
    },
    "secretRooms": {
      ".read": false,
      "$code": {
        ".write": "newData.child('k').val() === root.child('srKey/v').val()",
        ".validate": "newData.hasChildren(['k','pub'])",
        "pub": {
          ".read": true,
          ".validate": "newData.hasChildren(['owner','ts']) && newData.child('owner').isString() && newData.child('owner').val().length <= 64 && newData.child('ts').isNumber() && (!newData.child('name').exists() || newData.child('name').val().length <= 20)"
        }
      }
    },
    "rooms": {
      ".read": true,
      "$room": {
        ".read": true,
        ".write": "!newData.exists()",
        "_meta": {
          ".write": true,
          ".validate": "(!newData.child('channel').exists() || (newData.child('channel').isString() && newData.child('channel').val().matches(/^(workingroom|togetherroom)$/))) && (!newData.child('host').exists() || (newData.child('host').isString() && newData.child('host').val().length <= 40)) && (!newData.child('ts').exists() || newData.child('ts').isNumber())"
        },
        "chatLog": {
          ".write": true,
          "$msgId": {
            ".write": true,
            ".validate": "newData.hasChildren(['name','text','ts']) && newData.child('name').isString() && newData.child('name').val().length <= 20 && newData.child('text').isString() && newData.child('text').val().length <= 1200 && newData.child('ts').isNumber() && (!newData.child('uid').exists() || (newData.child('uid').isString() && newData.child('uid').val().length <= 40))"
          }
        },
        "_photo": {
          ".read": true,
          "slots": {
            ".write": true,
            ".validate": "newData.getPriority() == null",
            "$i": {
              ".validate": "$i.matches(/^[0-3]$/) && newData.hasChildren(['uid','at']) && newData.child('at').isNumber() && newData.child('at').val() <= now + 60000 && (!data.exists() || data.child('uid').val() === newData.child('uid').val() || data.child('at').val() < now - 900000)",
              "uid": {
                ".validate": "newData.isString() && newData.val().length <= 64"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 24"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "meta": {
            ".write": "newData.child('host').isString() && (root.child('rooms').child($room).child('_photo').child('slots').child('0').exists() ? root.child('rooms').child($room).child('_photo').child('slots').child('0').child('uid').val() === newData.child('host').val() : root.child('rooms').child($room).child('_photo').child('slots').child('1').exists() ? root.child('rooms').child($room).child('_photo').child('slots').child('1').child('uid').val() === newData.child('host').val() : root.child('rooms').child($room).child('_photo').child('slots').child('2').exists() ? root.child('rooms').child($room).child('_photo').child('slots').child('2').child('uid').val() === newData.child('host').val() : root.child('rooms').child($room).child('_photo').child('slots').child('3').exists() && root.child('rooms').child($room).child('_photo').child('slots').child('3').child('uid').val() === newData.child('host').val())",
            "orient": {
              ".validate": "(newData.val() === 'p' || newData.val() === 'l') && !(newData.val() === 'p' && newData.parent().child('cuts').val() === 2)"
            },
            "cuts": {
              ".validate": "(newData.val() === 1 || newData.val() === 4 || (newData.val() === 2 && newData.parent().child('orient').val() === 'l'))"
            },
            "bg": {
              ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().matches(/^(white|sky|sepia|blue|red|gray)(,(white|sky|sepia|blue|red|gray))*$/)"
            },
            "filter": {
              ".validate": "newData.val() === 'none' || newData.val() === 'soft' || newData.val() === 'ps1' || newData.val() === 'mono' || newData.val() === 'dawn' || newData.val() === 'vint' || newData.val() === 'toon'"
            },
            "camH": {
              ".validate": "newData.isNumber() && newData.val() >= 0.5 && newData.val() <= 2.6"
            },
            "camP": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 26"
            },
            "basic": {
              ".validate": "newData.val() === 'none' || newData.val() === 'white' || newData.val() === 'black'"
            },
            "state": {
              ".validate": "newData.val() === 'lobby' || newData.val() === 'shooting' || newData.val() === 'done'"
            },
            "cut": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
            },
            "cutAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            },
            "host": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "startedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "frames": {
            ".write": true,
            "$i": {
              ".validate": "$i.matches(/^[0-3]$/) && (!newData.exists() || (newData.isString() && newData.val().length <= 512 && newData.val().matches(/^https:\\/\\//)))"
            }
          },
          "p": {
            "$i": {
              ".write": "root.child('rooms').child($room).child('_photo').child('slots').child($i).exists()",
              ".validate": "$i.matches(/^[0-3]$/) && (!newData.exists() || (newData.isString() && newData.val().length <= 24 && newData.val().matches(/^-?[0-9]+,-?[0-9]+(,-?[0-9]+,-?[0-9]+,-?[0-9]+)?$/)))"
            }
          },
          "ev": {
            "$i": {
              ".write": "root.child('rooms').child($room).child('_photo').child('slots').child($i).exists()",
              ".validate": "$i.matches(/^[0-3]$/) && (!newData.exists() || newData.hasChild('k'))",
              "k": {
                ".validate": "newData.val() === 'jump' || newData.val() === 'pose' || newData.val() === 'blink'"
              },
              "v": {
                ".validate": "!newData.exists() || newData.isNumber()"
              },
              "ts": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "shot": {
            ".write": "root.child('rooms').child($room).child('_photo').child('slots').child('0').exists() || root.child('rooms').child($room).child('_photo').child('slots').child('1').exists() || root.child('rooms').child($room).child('_photo').child('slots').child('2').exists() || root.child('rooms').child($room).child('_photo').child('slots').child('3').exists()",
            "n": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$memberId": {
          ".write": true,
          ".validate": "newData.hasChildren(['name','state']) && newData.child('name').isString() && newData.child('name').val().length <= 20 && newData.child('state').isString() && newData.child('state').val().length <= 20 && (!newData.child('chat').exists() || (newData.child('chat').child('text').isString() && newData.child('chat').child('text').val().length <= 140 && (!newData.child('chat').child('fly').exists() || newData.child('chat').child('fly').isBoolean()) && (!newData.child('chat').child('flyColor').exists() || (newData.child('chat').child('flyColor').isString() && newData.child('chat').child('flyColor').val().length <= 16)) && (!newData.child('chat').child('flySize').exists() || (newData.child('chat').child('flySize').isString() && newData.child('chat').child('flySize').val().length <= 2)))) && (!newData.child('customStatus').exists() || (newData.child('customStatus').child('text').isString() && newData.child('customStatus').child('text').val().length <= 12 && (!newData.child('customStatus').child('emo').exists() || newData.child('customStatus').child('emo').val().length <= 4)))"
        }
      }
    },
    "roomIndex": {
      ".read": true,
      "$room": {
        ".write": true,
        ".validate": "newData.hasChild('lastSeen') && newData.child('lastSeen').isNumber() && (!newData.child('channel').exists() || (newData.child('channel').isString() && newData.child('channel').val().matches(/^(workingroom|togetherroom)$/))) && (!newData.child('open').exists() || newData.child('open').isBoolean())"
      }
    },
    "licenses": {
      ".read": "root.child('admins').child(auth.uid).val() === true",
      "$key": {
        ".read": true,
        ".write": "root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['valid','createdAt']) && newData.child('valid').isBoolean() && newData.child('note').val().length <= 100",
        "redeemedAt": {
          ".write": "!data.exists() && root.child('licenses').child($key).exists()",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "licenseRequests": {
      ".read": "root.child('admins').child(auth.uid).val() === true",
      "$reqId": {
        ".write": true,
        ".validate": "newData.hasChildren(['name','status']) && newData.child('name').isString() && newData.child('name').val().length <= 20 && newData.child('status').isString() && newData.child('status').val().length <= 20",
        ".read": true
      }
    },
    "catalog": {
      "parts": {
        ".read": true,
        "$partId": {
          ".write": "root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['cat','name']) && newData.child('cat').isString() && newData.child('name').isString() && newData.child('name').val().length <= 30 && newData.child('icon').val().length <= 8 && ((newData.child('glb').exists() && newData.child('glb').isString() && newData.child('glb').val().length < 1400000) || (newData.child('glbUrl').exists() && newData.child('glbUrl').isString() && newData.child('glbUrl').val().length < 2048)) && (!newData.child('order').exists() || newData.child('order').isNumber()) && (!newData.child('gacha').exists() || newData.child('gacha').val() === false)"
        }
      },
      "gachaParts": {
        ".read": true,
        "$partId": {
          ".write": "root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['cat','name']) && newData.child('cat').isString() && newData.child('name').isString() && newData.child('name').val().length <= 30 && newData.child('icon').val().length <= 8 && ((newData.child('glb').exists() && newData.child('glb').isString() && newData.child('glb').val().length < 1400000) || (newData.child('glbUrl').exists() && newData.child('glbUrl').isString() && newData.child('glbUrl').val().length < 2048)) && (!newData.child('order').exists() || newData.child('order').isNumber()) && (!newData.child('season').exists() || (newData.child('season').isString() && newData.child('season').val().matches(/^(spring|summer|autumn|winter)?$/))) && (!newData.child('gacha').exists() || newData.child('gacha').isBoolean())"
        }
      },
      "desks": {
        ".read": true,
        "$deskId": {
          ".write": "root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 30 && newData.child('icon').val().length <= 8 && ((newData.child('glb').exists() && newData.child('glb').isString() && newData.child('glb').val().length < 1400000) || (newData.child('glbUrl').exists() && newData.child('glbUrl').isString() && newData.child('glbUrl').val().length < 2048))"
        }
      },
      "items": {
        ".read": true,
        "$itemId": {
          ".write": "root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 30 && newData.child('icon').val().length <= 8 && ((newData.child('glb').exists() && newData.child('glb').isString() && newData.child('glb').val().length < 1400000) || (newData.child('glbUrl').exists() && newData.child('glbUrl').isString() && newData.child('glbUrl').val().length < 2048)) && (!newData.child('order').exists() || newData.child('order').isNumber())"
        }
      },
      "customCats": {
        ".read": true,
        "$catId": {
          ".write": "root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['cat','label','group']) && newData.child('cat').isString() && newData.child('cat').val().length <= 20 && newData.child('label').isString() && newData.child('label').val().length <= 20 && newData.child('group').isString() && newData.child('group').val().matches(/^(head|cloth|deco|hand)$/) && (!newData.child('icon').exists() || newData.child('icon').val().length <= 8) && (!newData.child('bone').exists() || newData.child('bone').val().length <= 10)"
        }
      },
      "adBanner": {
        ".read": true,
        ".write": "root.child('admins').child(auth.uid).val() === true"
      },
      "catOverrides": {
        ".read": true,
        "$catId": {
          ".write": "root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['label']) && newData.child('label').isString() && newData.child('label').val().length <= 20 && (!newData.child('icon').exists() || newData.child('icon').val().length <= 8)"
        }
      },
      "gameConfig": {
        ".read": true,
        ".write": "root.child('admins').child(auth.uid).val() === true",
        "animalUnlockLevel": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
        }
      }
    },
    "authUsers": {
      "$authUid": {
        ".read": "auth != null && auth.uid === $authUid",
        ".write": "auth != null && auth.uid === $authUid",
        ".validate": "newData.hasChildren(['userCode'])",
        "userCode": {
          ".validate": "newData.isString() && newData.val().length <= 40 && (!data.exists() || data.val() === newData.val() || root.child('userAuth/'+newData.val()).val() === auth.uid)"
        },
        "email": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)"
        },
        "ts": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "accountSnap": {
      "$userId": {
        ".read": "auth != null && root.child('userAuth/'+$userId).val() === auth.uid",
        ".write": "auth != null && root.child('userAuth/'+$userId).val() === auth.uid",
        ".validate": "newData.hasChildren(['ts'])",
        "license": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "focusTotalSec": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 359640000"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "friendCode": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "userAuth": {
      "$userId": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid) && (!newData.exists() || newData.val() === auth.uid)",
        ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 128)"
      }
    },
    "friendCodes": {
      ".read": true,
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['userId']) && newData.child('userId').isString() && newData.child('userId').val().length <= 40"
      }
    },
    "users": {
      "$userId": {
        ".read": true,
        "secretRoom": {
          ".write": "!root.child('userAuth/'+$userId).exists() || root.child('userAuth/'+$userId).val() === auth.uid",
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 12)"
        },
        "friendCode": {
          ".write": "!root.child('userAuth/'+$userId).exists() || root.child('userAuth/'+$userId).val() === auth.uid",
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 12)"
        },
        "transferHash": {
          ".write": "!newData.exists() && (!root.child('userAuth/'+$userId).exists() || root.child('userAuth/'+$userId).val() === auth.uid)",
          ".validate": "false"
        },
        "transferData": {
          ".write": "!newData.exists() && (!root.child('userAuth/'+$userId).exists() || root.child('userAuth/'+$userId).val() === auth.uid)",
          ".validate": "false"
        },
        "mallang": {
          ".write": "!root.child('userAuth/'+$userId).exists() || root.child('userAuth/'+$userId).val() === auth.uid"
        },
        "mallangGifts": {
          ".write": true,
          "$giftId": {
            ".validate": "newData.hasChildren(['imgUrl','ts']) && newData.child('imgUrl').isString() && newData.child('imgUrl').val().length <= 400 && (!newData.child('fromName').exists() || newData.child('fromName').val().length <= 20) && (!newData.child('fromId').exists() || newData.child('fromId').val().length <= 40) && newData.child('ts').isNumber() && (!newData.child('msg').exists() || (newData.child('msg').isString() && newData.child('msg').val().length <= 50)) && (!newData.child('hidden').exists() || newData.child('hidden').isBoolean())"
          }
        },
        "mallangGiftCount": {
          ".write": "!root.child('userAuth/'+$userId).exists() || root.child('userAuth/'+$userId).val() === auth.uid",
          "$date": {
            ".validate": "newData.isNumber()"
          }
        },
        "mallangGiftSeen": {
          ".write": "!root.child('userAuth/'+$userId).exists() || root.child('userAuth/'+$userId).val() === auth.uid",
          ".validate": "newData.isNumber()"
        },
        "profile": {
          ".write": "!root.child('userAuth/'+$userId).exists() || root.child('userAuth/'+$userId).val() === auth.uid",
          ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 20 && (!newData.child('level').exists() || (newData.child('level').isNumber() && newData.child('level').val() >= 1 && newData.child('level').val() <= 9999))"
        },
        "focus": {
          ".write": "!root.child('userAuth/'+$userId).exists() || root.child('userAuth/'+$userId).val() === auth.uid",
          ".validate": "!newData.child('totalSec').exists() || (newData.child('totalSec').isNumber() && newData.child('totalSec').val() >= 0 && newData.child('totalSec').val() <= 359640000)"
        },
        "gacha": {
          ".write": "!root.child('userAuth/'+$userId).exists() || root.child('userAuth/'+$userId).val() === auth.uid",
          "ts": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "owned": {
            "$partId": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999"
            }
          }
        },
        "slots": {
          ".write": "!root.child('userAuth/'+$userId).exists() || root.child('userAuth/'+$userId).val() === auth.uid",
          "ts": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "v": {
            ".validate": "newData.isNumber()"
          },
          "s": {
            "$i": {
              ".validate": "$i.matches(/^[0-4]$/) && newData.isString() && newData.val().length <= 150000 && !newData.val().matches(/data:[a-z]+\\/[a-z0-9.+-]+;base64,/)"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "slotsPrev": {
          ".write": "!root.child('userAuth/'+$userId).exists() || root.child('userAuth/'+$userId).val() === auth.uid",
          "at": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "ts": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "v": {
            ".validate": "newData.isNumber()"
          },
          "s": {
            "$i": {
              ".validate": "$i.matches(/^[0-4]$/) && newData.isString() && newData.val().length <= 150000 && !newData.val().matches(/data:[a-z]+\\/[a-z0-9.+-]+;base64,/)"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "chars": {
          ".write": "!root.child('userAuth/'+$userId).exists() || root.child('userAuth/'+$userId).val() === auth.uid",
          "$cid": {
            ".validate": "$cid.matches(/^c[a-z0-9]{6,24}$/) && (newData.hasChild('def') || newData.hasChild('del'))",
            "def": { ".validate": "newData.isString() && newData.val().length <= 150000 && !newData.val().matches(/data:[a-z]+\\/[a-z0-9.+-]+;base64,/)" },
            "mtime": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "del": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "v": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "trash": {
          "$cid": {
            "$mtime": {
              ".write": "(!root.child('userAuth/'+$userId).exists() || root.child('userAuth/'+$userId).val() === auth.uid) && !data.exists() && newData.exists()",
              "def": { ".validate": "newData.isString() && newData.val().length <= 150000 && !newData.val().matches(/data:[a-z]+\\/[a-z0-9.+-]+;base64,/)" },
              "why": { ".validate": "newData.isString() && (newData.val() === 'overwritten' || newData.val() === 'deleted')" },
              "at": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "$other": { ".validate": false }
            }
          }
        },
        "charsMeta": {
          ".write": "!root.child('userAuth/'+$userId).exists() || root.child('userAuth/'+$userId).val() === auth.uid",
          "migratedFrom": { ".validate": "newData.isString() && newData.val() === 'slots'" },
          "migratedAt": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "claimAt": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "ts": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "v": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "chalBonus": {
          ".write": "!root.child('userAuth/'+$userId).exists() || root.child('userAuth/'+$userId).val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999"
        },
        "chal": {
          ".write": "!root.child('userAuth/'+$userId).exists() || root.child('userAuth/'+$userId).val() === auth.uid",
          "ts": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "week": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "kind": {
            ".validate": "newData.val() === 'focus' || newData.val() === 'repeat' || newData.val() === 'rule' || newData.val() === ''"
          },
          "paid": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "skip": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "auto": {
            ".validate": "newData.isBoolean()"
          },
          "paused": {
            ".validate": "newData.isBoolean()"
          },
          "days": {
            "$i": {
              ".validate": "newData.isNumber() && newData.val() >= -3 && newData.val() <= 1"
            }
          },
          "phase": {
            ".validate": "newData.val() === 'wd' || newData.val() === 'we'"
          },
          "paidWe": {
            ".validate": "newData.isString() && newData.val().length <= 10"
